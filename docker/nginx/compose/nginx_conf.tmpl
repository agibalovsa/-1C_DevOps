server {

  listen 80;
  listen [::]:80;

  server_name {{ env "NGINX_SERVER_NAME" }};

  proxy_buffering on;
  proxy_buffer_size 2k;
  proxy_buffers 24 4k;
  proxy_busy_buffers_size 8k;
  proxy_max_temp_file_size 2048m;
  proxy_temp_file_write_size 32k;

  location /{{ or (env "CA_LOCAL") "public_certs" }}/ {

    proxy_pass http://{{ or (env "CA_URL") "ca" }}{{ with env "CA_PORT" }}:{{ . }}{{ end }};

  }

  location /.well-known/acme-challenge {
    try_files $uri $uri/ =404; root /usr/share/nginx/html;
  }

}

server {

  listen 443 ssl;
  listen [::]:443 ssl;
  http2  on;

  server_name {{ env "NGINX_SERVER_NAME" }};

  ssl_certificate_key /etc/nginx/ssl/{{ env "NGINX_SERVER_NAME" }}.key;
  ssl_certificate     /etc/nginx/ssl/{{ env "NGINX_SERVER_NAME" }}.crt;

  location /{{ or (env "CA_LOCAL") "public_certs" }}/ {

    proxy_pass {{ or (env "CA_PROTOCOL") "http" }}://{{ or (env "CA_URL") "ca" }}{{ with env "CA_PORT" }}:{{ . }}{{ end }};

  }

  location /{{ or (env "APTLY_LOCAL") "aptly" }}/ {

    auth_basic "Restricted";
    auth_basic_user_file /etc/nginx/auth/.htpasswd;

    proxy_pass {{ or (env "APTLY_PROTOCOL") "http" }}://{{ or (env "APTLY_URL") "aptly" }}{{ with env "APTLY_PORT" }}:{{ . }}{{ end }}/;

  }

  location /{{ or (env "GITLAB_LOCAL") "gitlab" }}/ {

    client_max_body_size 0;
    gzip off;

    proxy_set_header Host                 $http_host;
    proxy_set_header X-Real-IP            $remote_addr;
    proxy_set_header X-Forwarded-For      $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto    $scheme;
    proxy_set_header X-Forwarded-Protocol $scheme;
    proxy_set_header X-Url-Scheme         $scheme;

    proxy_read_timeout 300;
    proxy_connect_timeout 300;

    proxy_pass {{ or (env "GITLAB_PROTOCOL") "https" }}://{{ or (env "GITLAB_URL") "gitlab" }}{{ with env "GITLAB_PORT" }}:{{ . }}{{ end }};

  }

  location /{{ or (env "SONAR_LOCAL") "sonarqube" }}/ {

    client_max_body_size 5000M;

    proxy_set_header Host                 $host;
    proxy_set_header X-Real-IP            $remote_addr;
    proxy_set_header X-Forwarded-For      $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto    $scheme;
    proxy_set_header X-Forwarded-Protocol $scheme;
    proxy_set_header X-Url-Scheme         $scheme;

    proxy_pass {{ or (env "SONAR_PROTOCOL") "http" }}://{{ or (env "SONAR_URL") "sonarqube" }}{{ with env "SONAR_PORT" }}:{{ . }}{{ end }};

  }

  location /{{ or (env "OPENSEARCH_DASHBOARD_LOCAL") "opensearch/dbd" }}/ {

    proxy_pass {{ or (env "OPENSEARCH_DASHBOARD_PROTOCOL") "http" }}://{{ or (env "OPENSEARCH_DASHBOARD_URL") "opensearch-dashboards" }}:{{ or (env "OPENSEARCH_DASHBOARD_PORT") "5601" }};

  }

  location /{{ or (env "OPENSEARCH_LOCAL") "opensearch" }}/ {

    proxy_ssl_verify off;
    client_max_body_size 10M;

    proxy_pass {{ or (env "OPENSEARCH_PROTOCOL") "https" }}://{{ or (env "OPENSEARCH_URL") "opensearch" }}:{{ or (env "OPENSEARCH_PORT") "9200" }}/;

  }

  location /{{ or (env "PORTAINER_LOCAL") "portainer" }}/ {

    proxy_ssl_verify off;
    client_max_body_size 0;

    proxy_set_header Host                 $host;
    proxy_set_header X-Real-IP            $remote_addr;
    proxy_set_header X-Forwarded-For      $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto    $scheme;
    proxy_set_header X-Forwarded-Protocol $scheme;
    proxy_set_header X-Url-Scheme         $scheme;
    proxy_set_header Upgrade              $http_upgrade;
    proxy_set_header Connection           "upgrade";

    proxy_cache_bypass $http_upgrade;

    proxy_pass {{ or (env "PORTAINER_PROTOCOL") "https" }}://{{ or (env "PORTAINER_URL") "portainer" }}{{ with env "PORTAINER_HTTPS_PORT" }}:{{ . }}{{ end }}/;

  }

  location /{{ or (env "PLANTUML_LOCAL") "plantuml" }}/ {

    proxy_set_header  Host               $host;
    proxy_set_header  X-Forwarded-Host   $host;
    proxy_set_header  X-Forwarded-Proto  $scheme;

    proxy_pass {{ or (env "PLANTUML_PROTOCOL") "http" }}://{{ or (env "PLANTUML_URL") "plantuml" }}:{{ or (env "PLANTUML_PORT") "8080" }}/{{ or (env "PLANTUML_LOCAL") "plantuml" }}/;
  }

  location /{{ or (env "DRAWIO_LOCAL") "draw-io" }}/ {

    proxy_set_header  Host               $host;
    proxy_set_header  X-Forwarded-Host   $host;
    proxy_set_header  X-Forwarded-Proto  $scheme;

    proxy_pass {{ or (env "DRAWIO_PROTOCOL") "http" }}://{{ or (env "DRAWIO_URL") "draw-io" }}:{{ or (env "DRAWIO_PORT") "8080" }}/;
  }

  location /{{ or (env "OC_LOCAL") "1c" }}/ {

    client_max_body_size 2000M;

    proxy_set_header Host                 $host;
    proxy_set_header X-Real-IP            $remote_addr;
    proxy_set_header X-Forwarded-For      $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto    $scheme;
    proxy_set_header X-Forwarded-Protocol $scheme;
    proxy_set_header X-Url-Scheme         $scheme;

    proxy_pass {{ or (env "OC_PROTOCOL") "http" }}://{{ or (env "OC_URL") "1c" }}{{ with env "OC_PORT" }}:{{ . }}{{ end }}/{{ or (env "OC_LOCAL") "1c" }}/;
  }

  location /{{ or (env "OC_REPO_LOCAL") "repository" }}/ {

    client_max_body_size 7000M;

    proxy_send_timeout    3600s;
    proxy_read_timeout    3600s;
    proxy_connect_timeout 3600s;

    proxy_pass {{ or (env "OC_REPO_PROTOCOL") "http" }}://{{ or (env "OC_REPO_URL") "1c" }}{{ with env "OC_REPO_PORT" }}:{{ . }}{{ end }}/{{ or (env "OC_REPO_LOCAL") "repository" }}/;

  }

  location /{{ or (env "NEXTCLOUD_LOCAL") "nextcloud" }}/ {
    
    # Security headers
    add_header X-Content-Type-Options nosniff;
    add_header X-XSS-Protection "1; mode=block";
    add_header X-Robots-Tag none;
    add_header X-Download-Options noopen;
    add_header X-Permitted-Cross-Domain-Policies none;
    add_header Referrer-Policy no-referrer;
    
    # HSTS (if using HTTPS)
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;    

    # Optimizations
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_redirect off;
    proxy_cache off;

    # Timeout settings for large file uploads
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
    proxy_connect_timeout 3600s;

    # Increase max upload size (adjust as needed)
    client_body_timeout 300s;
    client_max_body_size 10G;
    client_body_buffer_size 512k;

    # WebSocket support
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";

    # Base
    proxy_set_header Host                 $host;
    proxy_set_header X-Real-IP            $remote_addr;
    proxy_set_header X-Forwarded-For      $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto    $scheme;
    proxy_set_header X-Forwarded-Protocol $scheme;
    proxy_set_header X-Url-Scheme         $scheme;

    proxy_pass {{ or (env "NEXTCLOUD_PROTOCOL") "https" }}://{{ or (env "NEXTCLOUD_URL") "nextcloud" }}{{ with env "NEXTCLOUD_PORT" }}:{{ . }}{{ end }};

  }

  location /.well-known/carddav {
    return 301 $scheme://$host/{{ or (env "NEXTCLOUD_LOCAL") "nextcloud" }}/remote.php/dav;
  }
  location /.well-known/caldav {
    return 301 $scheme://$host/{{ or (env "NEXTCLOUD_LOCAL") "nextcloud" }}/remote.php/dav;
  }
  location /.well-known/webfinger {
    return 301 $scheme://$host/{{ or (env "NEXTCLOUD_LOCAL") "nextcloud" }}/index.php/.well-known/webfinger;
  }
  location /.well-known/nodeinfo {
    return 301 $scheme://$host/{{ or (env "NEXTCLOUD_LOCAL") "nextcloud" }}/index.php/.well-known/nodeinfo;
  }

}

server {

  listen 5000 ssl;
  listen [::]:5000 ssl;
  http2  on;

  server_name {{ env "NGINX_SERVER_NAME" }};

  ssl_certificate_key /etc/nginx/ssl/{{ env "NGINX_SERVER_NAME" }}.key;
  ssl_certificate     /etc/nginx/ssl/{{ env "NGINX_SERVER_NAME" }}.crt;
  
  # Recommendations from https://raymii.org/s/tutorials/Strong_SSL_Security_On_nginx.html
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_ciphers 'EECDH+AESGCM:EDH+AESGCM:AES256+EECDH:AES256+EDH';
  ssl_prefer_server_ciphers on;
  ssl_session_cache shared:SSL:10m;

  # required to avoid HTTP 411: see Issue #1486 (https://github.com/moby/moby/issues/1486)
  chunked_transfer_encoding on;

  location /v2/ {

    # Optimizations
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_redirect off;
    proxy_cache off;

    # Timeout settings for large file uploads
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
    proxy_connect_timeout 3600s;

    # Increase max upload size (adjust as needed)
    client_body_timeout 300s;
    # disable any limits to avoid HTTP 413 for large image uploads
    client_max_body_size 10G;
    client_body_buffer_size 512k;

    # Do not allow connections from docker 1.5 and earlier
    # docker pre-1.6.0 did not properly set the user agent on ping, catch "Go *" user agents
    if ($http_user_agent ~ "^(docker\/1\.(3|4|5(?!\.[0-9]-dev))|Go ).*$" ) {
      return 404;
    }

    ## If $docker_distribution_api_version is empty, the header is not added.
    ## See the map directive above where this variable is defined.
    #add_header 'Docker-Distribution-Api-Version' $docker_distribution_api_version always;
    
    proxy_set_header  Host              $http_host;   # required for docker client's sake
    proxy_set_header  X-Real-IP         $remote_addr; # pass on real client's IP
    proxy_set_header  X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header  X-Forwarded-Proto $scheme;

    proxy_pass https://{{ or (env "DOCKER_REGISTRY_URL") "docker-registry" }}:{{ or (env "DOCKER_REGISTRY_PORT") "5000" }};

  }

}
