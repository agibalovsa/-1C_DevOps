# ## Nginx compose options

# ### names

NGINX_TAG="${NGINX_TAG}"
NGINX_HOSTNAME="${NGINX_HOSTNAME:-nginx}"
NGINX_NAME="${NGINX_NAME:-nginx}"

NGINX_SERVER_NAME="${NGINX_SERVER_NAME}"

# ### configs

# > CA nginx conf
CA_PROTOCOL="${CA_PROTOCOL:-http}"
CA_URL="${CA_URL:-ca}"
CA_PORT="${CA_PORT}"
CA_LOCAL="${CA_LOCAL:-ca}"

# > Aptly nginx conf
APTLY_PROTOCOL="${APTLY_PROTOCOL:-http}"
APTLY_URL="${APTLY_URL:-aptly}"
APTLY_PORT="${APTLY_PORT}"
APTLY_LOCAL="${APTLY_LOCAL:-aptly}"

# > Gitlab nginx conf
GITLAB_PROTOCOL="${GITLAB_PROTOCOL:-https}"
GITLAB_URL="${GITLAB_URL:-gitlab}"
GITLAB_SSH_PORT="${GITLAB_SSH_PORT:-22155}"
GITLAB_HTTPS_PORT="${GITLAB_HTTPS_PORT}"
GITLAB_LOCAL="${GITLAB_LOCAL:-gitlab}"

# > Sonar nginx conf
SONAR_PROTOCOL="${SONAR_PROTOCOL:-http}"
SONAR_URL="${SONAR_URL:-sonarqube}"
SONAR_HTTP_PORT="${SONAR_HTTP_PORT}"
SONAR_LOCAL="${SONAR_LOCAL:-sonarqube}"

# > Opensearch nginx conf
OPENSEARCH_PROTOCOL="${OPENSEARCH_PROTOCOL:-https}"
OPENSEARCH_URL="${OPENSEARCH_URL:-opensearch}"
OPENSEARCH_API_PORT="${OPENSEARCH_API_PORT:-9200}"
OPENSEARCH_LOCAL="${OPENSEARCH_LOCAL:-opensearch}"
OPENSEARCH_DASHBOARD_PROTOCOL="${OPENSEARCH_DASHBOARD_PROTOCOL:-http}"
OPENSEARCH_DASHBOARD_URL="${OPENSEARCH_DASHBOARD_URL:-opensearch-dashboards}"
OPENSEARCH_DASHBOARD_PORT="${OPENSEARCH_DASHBOARD_PORT:-5601}"
OPENSEARCH_DASHBOARD_LOCAL="${OPENSEARCH_DASHBOARD_LOCAL:-opensearch/dbd}"

# > Portainer nginx conf
PORTAINER_PROTOCOL="${PORTAINER_PROTOCOL:-https}"
PORTAINER_URL="${PORTAINER_URL:-portainer}"
PORTAINER_HTTPS_PORT="${PORTAINER_HTTPS_PORT}"
PORTAINER_LOCAL="${PORTAINER_LOCAL:-portainer}"

# > PlantUML nginx conf
PLANTUML_PROTOCOL="${PLANTUML_PROTOCOL:-http}"
PLANTUML_URL="${PLANTUML_URL:-plantuml}"
PLANTUML_PORT="${PLANTUML_PORT:-8080}"
PLANTUML_LOCAL="${PLANTUML_LOCAL:-plantuml}"

# > Draw-io nginx conf
DRAWIO_PROTOCOL="${DRAWIO_PROTOCOL:-http}"
DRAWIO_URL="${DRAWIO_URL:-draw-io}"
DRAWIO_PORT="${DRAWIO_PORT:-8080}"
DRAWIO_LOCAL="${DRAWIO_LOCAL:-draw-io}"

# > 1C nginx conf
OC_PROTOCOL="${OC_PROTOCOL:-http}"
OC_URL="${OC_URL:-1c}"
OC_PORT="${OC_PORT}"
OC_LOCAL="${OC_LOCAL:-1c}"

OC_REPO_PROTOCOL="${OC_REPO_PROTOCOL:-http}"
OC_REPO_URL="${OC_REPO_URL}"
OC_REPO_PORT="${OC_REPO_PORT}"
OC_REPO_LOCAL="${OC_REPO_LOCAL}"

# > Nextcloud nginx conf
NEXTCLOUD_PROTOCOL="${NEXTCLOUD_PROTOCOL:-https}"
NEXTCLOUD_URL="${NEXTCLOUD_URL:-nextcloud}"
NEXTCLOUD_PORT="${NEXTCLOUD_PORT}"
NEXTCLOUD_LOCAL="${NEXTCLOUD_LOCAL:-nextcloud}"

# > Docker registry nginx conf
DOCKER_REGISTRY_URL="${DOCKER_REGISTRY_URL:-docker-registry}"
DOCKER_REGISTRY_PORT="${DOCKER_REGISTRY_PORT:-5000}"

# ### resources

NGINX_LOG_SIZE="${NGINX_LOG_SIZE:-100M}"

NGINX_NETWORK="${NGINX_NETWORK:-nginx_network}"

NGINX_CONF_VOL="${NGINX_CONF_VOL:-nginx_conf}"
NGINX_STREAM_VOL="${NGINX_STREAM_VOL:-nginx_stream}"
NGINX_SSL_VOL="${NGINX_SSL_VOL:-nginx_ssl}"

