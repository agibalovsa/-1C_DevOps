# ## Step-ca cli compose options

# ### names

STEP_CA_NAME="${STEP_CA_NAME:-step-ca-cli}"
STEP_TAG="${STEP_TAG}"
STEP_CA_HOSTNAME="${STEP_CA_HOSTNAME:-step-ca-cli}"

# ### configs

DOMAIN_NAME="${DOMAIN_NAME}"
STEP_URL="${STEP_URL}"
STEP_FINGERPRINT="${STEP_FINGERPRINT}"
USER_DOMAIN_ID="${USER_DOMAIN_ID:-1001}"
GROUP_DOMAIN_ID="${GROUP_DOMAIN_ID:-1001}"
SEND_SIG="${SEND_SIG:-0}"
SIGNAL="${SIGNAL:-kill?signal=SIGHUP}"
CERT_FORMAT="${CERT_FORMAT:-CRT}"
BACKGROUND="${BACKGROUND:-0}"

# ### resources

STEP_CA_NETWORK="${STEP_CA_NETWORK:-step_ca_cli_network}"
STEP_CA_PORT="${STEP_CA_PORT:-80}"
STEP_CA_CERTS_VOL="${STEP_CA_CERTS_VOL:-step_ca_certs}"
STEP_CA_CONF_VOL="${STEP_CA_CONF_VOL:-step_ca_config}"

# ### swarm

STEP_CA_NODE="${STEP_CA_NODE}"
