#!/usr/bin/env bash

# Compilation of imagemagick deb packages
#  $1 - Deb dir
#
compile_deb() {

    apt-get update \
        && apt-get install -y --no-install-recommends git make cmake checkinstall build-essential yasm nasm;
    apt-get clean \
        && rm -rf /var/lib/apt/lists/*;

    # shellcheck disable=SC2153
    git clone https://github.com/SoftCreatR/imei \
        && cd imei \
        && ([ -n "${IMEI_VERSION}" ] && git checkout "${IMEI_VERSION}") \
        && chmod +x imei.sh \
        && ./imei.sh --build-local --no-install \
            --imagemagick-version "${IM_VERSION}" \
            --aom-version "${AOM_VERSION}" \
            --libheif-version "${HEIF_VERSION}" \
            --jpeg-xl-version "${JXL_VERSION}"

    mkdir -p "${1}"
    mv "/imei/dist/debian$(grep -oP '^VERSION_ID="\K[^"]+' /etc/os-release)/"*.deb "${1}"

}