#!/usr/bin/env bash

install_from_url ()
{

    # shellcheck disable=SC1091
    . "/scripts/1c/oc_lib.sh"

    savePath="/tmp/install_deb"
    getClient="0"

    if [[ "${INSTALL_FILES}" == *"-client"* ]]; then
        getClient="1"
    fi
    
    get_deb_from_url "${savePath}" "${OC_VERSION}" "${getClient}" "${OC_URL_LOGIN}" "${OC_URL_PASSWORD}"  

    unzip "${savePath}/*.zip" -d "${savePath}"

    for installFile in ${INSTALL_FILES}; do
        dpkg -i "${savePath}/${installFile}"
    done;

    rm -r "${savePath}"

}